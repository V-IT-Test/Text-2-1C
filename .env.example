# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env уже добавлен в .gitignore — он НЕ попадёт в репозиторий.

# Ключ от прокси для OpenAI-совместимого API (proxyapi.ru или другой).
PROXYAPI_KEY=sk-your-key-here

# Базовый URL API (по умолчанию proxyapi.ru). Раскомментируйте для другого провайдера.
# PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модель по умолчанию (можно переопределять в UI).
# LLM_MODEL=gpt-4o-mini
